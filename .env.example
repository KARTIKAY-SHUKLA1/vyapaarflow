# Copy to .env.local and fill in. Never commit real values.

# Local SQLite file by default; a libsql://... Turso URL in production.
DATABASE_URL=file:./data/local.db
# Turso only.
DATABASE_AUTH_TOKEN=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# "true" shows demo accounts and the simulated OTP on the login screen.
DEMO_MODE=true

# AI order capture (optional). Without a key the deterministic rules engine is used
# and the desk UI labels captures as "rule-based".
ANTHROPIC_API_KEY=
# Optional model override; default claude-haiku-5-5 (claude-sonnet-5-5 for higher accuracy).
ANTHROPIC_MODEL=
