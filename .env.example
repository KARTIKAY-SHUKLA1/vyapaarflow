# Copy to .env.local and fill in. Never commit real values.

# Local SQLite file by default. In production (NODE_ENV=production) the server refuses to start
# without a remote libsql://... Turso URL AND DATABASE_AUTH_TOKEN. To run the production build
# against a local file on your own machine, set ALLOW_LOCAL_DATABASE=true.
DATABASE_URL=file:./data/local.db
# Turso only; required in production.
DATABASE_AUTH_TOKEN=
# db:seed and db:reset WIPE EVERY TABLE. Against a remote database they refuse to run unless
# you pass --allow-remote-wipe (npm run db:reset -- --allow-remote-wipe) or set ALLOW_REMOTE_WIPE=true.
# ALLOW_REMOTE_WIPE=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# "true" shows demo accounts and the simulated OTP on the login screen, so ANYONE with the link
# can sign in as any user, desk staff included. Use it only with the fictional seed data, never
# with real retailers, prices or phone numbers. Set "false" (and connect a real SMS provider) for real use.
DEMO_MODE=true

# AI order capture (optional). Without a key the deterministic rules engine is used
# and the desk UI labels captures as "rule-based".
ANTHROPIC_API_KEY=
# Optional model override; default claude-haiku-5-5 (claude-sonnet-5-5 for higher accuracy).
ANTHROPIC_MODEL=

# Model provider (optional). AI_PROVIDER: anthropic | gemini | openai-compatible | none.
# Unset: Anthropic if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
# else openai-compatible if AI_BASE_URL and AI_MODEL are set.
# With no provider configured the rule-based matcher is used and labelled "rule-based" in the UI.
AI_PROVIDER=
# Google Gemini (Gemini Developer API, generateContent).
GEMINI_API_KEY=
# Optional; default gemini-3.5-flash-lite.
GEMINI_MODEL=
# Optional: minimal | low (default) | medium | high. Not every model accepts minimal.
GEMINI_THINKING_LEVEL=

# Any OpenAI-compatible Chat Completions endpoint, e.g. a local server at http://localhost:11434/v1.
AI_BASE_URL=
AI_MODEL=
# Optional; local servers usually need none.
AI_API_KEY=
# json_schema (default) or json_object for endpoints without JSON-schema support.
AI_JSON_MODE=
