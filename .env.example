# Copy to .env.local and fill in. Never commit real values.

# Local SQLite file by default; a libsql://... Turso URL in production.
DATABASE_URL=file:./data/local.db
# Turso only.
DATABASE_AUTH_TOKEN=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# "true" shows demo accounts and the simulated OTP on the login screen.
DEMO_MODE=true
